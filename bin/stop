#!/usr/bin/env bash
# Stop the Design Explorer singleton server.
set -euo pipefail

PID_FILE="$HOME/.claude/design-explorer.pid"
PORT=${1:-10000}

# Try graceful shutdown via PID file
if [[ -f "$PID_FILE" ]]; then
  PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
    kill "$PID" 2>/dev/null
    echo "Stopped server (PID $PID)"
    exit 0
  else
    rm -f "$PID_FILE"
  fi
fi

# Fallback: ask the server on this port for its PID, so nothing else gets killed
PID=$(curl -sf --max-time 2 "http://127.0.0.1:$PORT/health" 2>/dev/null \
  | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const h=JSON.parse(s);if(h.pid)console.log(h.pid)}catch{}})' || true)
if [[ -n "$PID" ]]; then
  kill "$PID" 2>/dev/null
  echo "Stopped server (PID $PID)"
else
  echo "Server not running"
fi
